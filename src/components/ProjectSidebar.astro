---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { sitePath } from '../utils/paths';

type Project = CollectionEntry<'projects'>;
type ProjectSection = CollectionEntry<'projectSections'>;

interface Props {
	project: Project;
	sections: ProjectSection[];
	currentSection: string;
}

const { project, sections, currentSection } = Astro.props;
const projectSlug = project.id.split('/')[0];
const targetDetectionSidebarTitles: Record<string, string> = {
	'detection-fundamentals': 'Detection basics',
	'dataset-design': 'Dataset design',
	'training-theory': 'Training theory',
	'evaluation-theory': 'Evaluation metrics',
	'inference-theory': 'Inference theory',
	data: 'Data collection',
	training: 'Train model',
	evaluation: 'Review results',
	limits: 'Limits & use',
};
const items = sections.map((section) => {
	const id = section.id.split('/').at(-1) ?? section.id;

	return {
		id,
		title:
			projectSlug === 'target-detection'
				? targetDetectionSidebarTitles[id] ?? section.data.title
				: section.data.title,
		group: section.data.group,
		order: section.data.order,
	};
});
const groups = new Map<string, typeof items>();
for (const item of items) {
	const group = groups.get(item.group) ?? [];
	group.push(item);
	groups.set(item.group, group);
}
const orderedGroups = [...groups.entries()]
	.map(([name, groupItems]) => [name, groupItems.sort((a, b) => a.order - b.order)] as const)
	.sort((a, b) => a[1][0].order - b[1][0].order);

const sectionHref = (sectionId: string) => sitePath(`/projects/${projectSlug}/${sectionId}/`);
---

<details class="sidebar-disclosure" data-mobile-sidebar open>
	<summary class="sidebar-menu-summary">
		<Icon name="menu" />
		Menu
	</summary>
	<div class="project-sidebar-content">
		<header class="project-sidebar-heading">
			<p class="eyebrow">Project</p>
			<h2>{project.data.title}</h2>
			<div class="sidebar-project-actions">
				{project.data.repo && (
					<a class="button-outline" href={project.data.repo} target="_blank" rel="noopener noreferrer">
						<Icon name="github" /> Repository
					</a>
				)}
				{project.data.demo && (
					<a class="button-outline" href={project.data.demo} target="_blank" rel="noopener noreferrer">
						<Icon name="externalLink" /> Live demo
					</a>
				)}
			</div>
		</header>
		<nav aria-label={`${project.data.title} sections`}>
			<a
				class="sidebar-link sidebar-overview"
				href={sitePath(`/projects/${projectSlug}/`)}
				aria-current={currentSection === 'overview' ? 'page' : undefined}
			>
				Overview
			</a>
			{orderedGroups.map(([group, groupItems]) => (
				<details
					class:list={[
						'sidebar-group',
						{ 'sidebar-group-current': groupItems.some((item) => item.id === currentSection) },
					]}
					open
				>
					<summary>{group}</summary>
					{groupItems.map((item) => (
						<a
							class="sidebar-link"
							href={sectionHref(item.id)}
							aria-current={currentSection === item.id ? 'page' : undefined}
						>
							{item.title}
						</a>
					))}
				</details>
			))}
		</nav>
		<div class="sidebar-footer">
			<a class="sidebar-back" href={sitePath('/projects/')}>
				<Icon name="arrow" /> Other projects
			</a>
		</div>
	</div>
</details>

<style>
	.sidebar-disclosure {
		padding-block: 1.5rem;
		border-right: 1px solid var(--border);
	}

	.sidebar-menu-summary {
		display: none;
	}

	.project-sidebar-heading {
		padding: 0 0 1rem;
		margin-bottom: 0.75rem;
		border-bottom: 1px solid var(--border);
	}

	.project-sidebar-heading h2 {
		margin: 0 0 0.5rem;
		font-size: 1.2rem;
	}

	.sidebar-back {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.84rem;
	}

	.sidebar-back :global(svg),
	.sidebar-project-actions :global(svg),
	.sidebar-menu-summary :global(svg) {
		width: 1rem;
		height: 1rem;
	}

	.sidebar-project-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 0.75rem;
	}

	.sidebar-project-actions .button-outline {
		min-height: 2rem;
		padding: 0.25rem 0.45rem;
		font-size: 0.78rem;
	}

	.sidebar-footer {
		padding-top: 0.9rem;
		margin-top: 1rem;
		border-top: 1px solid var(--border);
	}

	.sidebar-group {
		margin: 0.5rem 0;
	}

	.sidebar-group summary {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		padding: 0.4rem;
		color: var(--text);
		font-size: 0.9rem;
		font-weight: 700;
		line-height: 1.4;
		cursor: pointer;
		list-style: none;
	}

	.sidebar-group summary::-webkit-details-marker {
		display: none;
	}

	.sidebar-group summary::before {
		width: 0.42rem;
		height: 0.42rem;
		flex: 0 0 0.42rem;
		align-self: center;
		border-right: 1.5px solid currentColor;
		border-bottom: 1.5px solid currentColor;
		content: '';
		position: relative;
		top: -0.18rem;
		transform: rotate(-45deg);
		transition: transform 150ms ease;
	}

	.sidebar-group[open] summary::before {
		transform: rotate(45deg);
	}

	.sidebar-group-current > summary {
		color: var(--accent);
		background: color-mix(in srgb, var(--accent) 22%, var(--surface));
		border-radius: 4px;
	}

	.sidebar-link {
		display: block;
		padding: 0.35rem 0.55rem 0.35rem 0.65rem;
		border-left: 3px solid transparent;
		border-radius: 0 4px 4px 0;
		color: var(--text);
		font-size: 0.9rem;
		font-weight: 500;
		text-decoration: none;
		transition:
			background-color 150ms ease,
			border-color 150ms ease;
	}

	.sidebar-group > .sidebar-link {
		padding: 0.55rem;
		margin-left: 1rem;
		font-family: var(--font-body);
		font-size: 0.82rem;
		font-weight: 400;
		line-height: 1.45;
	}

	.sidebar-overview {
		margin-bottom: 0.75rem;
	}

	.sidebar-link:hover {
		background: var(--hover-surface);
	}

	.sidebar-link[aria-current='page'] {
		border-left-color: var(--accent);
		background: color-mix(in srgb, var(--accent) 22%, var(--surface));
		font-weight: 700;
	}

	.sidebar-overview[aria-current='page'] {
		color: var(--accent);
	}

	.sidebar-group > .sidebar-link[aria-current='page'] {
		border-left-color: transparent;
		background: transparent;
		font-weight: 400;
		text-decoration: underline;
		text-decoration-color: var(--accent);
		text-decoration-thickness: 1.5px;
		text-underline-offset: 0.2em;
	}

	@media (max-width: 767px) {
		.sidebar-disclosure {
			padding-block: 0.75rem;
			border-right: 0;
			border-bottom: 1px solid var(--border);
		}

		.sidebar-menu-summary {
			display: flex;
			align-items: center;
			gap: 0.5rem;
			font-weight: 600;
		}

		.project-sidebar-content {
			padding-top: 0.9rem;
		}
	}
</style>
