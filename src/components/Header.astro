---
import Icon from './Icon.astro';
import { GITHUB_URL, SITE_TITLE } from '../consts';
import { sitePath, stripBasePath } from '../utils/paths';

const pathname = stripBasePath(Astro.url.pathname);
const isCurrent = (href: string) =>
	href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(`${href}/`);
---

<header class="site-header" data-pagefind-ignore>
	<div class="container nav-inner">
		<a class="brand" href={sitePath('/')} aria-label={`${SITE_TITLE} home`}>
			<span class="brand-mark" aria-hidden="true">M</span>
			<span class="brand-name">{SITE_TITLE.slice(1)}</span>
		</a>
		<button
			class="mobile-menu-toggle"
			type="button"
			data-menu-toggle
			aria-label="Open navigation menu"
			aria-controls="primary-nav"
			aria-expanded="false"
		>
			<Icon name="menu" class="menu-open-icon" />
			<Icon name="close" class="menu-close-icon" />
		</button>
		<nav id="primary-nav" class="primary-nav" aria-label="Primary navigation" data-open="false">
			<a href={sitePath('/')} aria-current={isCurrent('/') ? 'page' : undefined}>Home</a>
			<a href={sitePath('/projects/')} aria-current={isCurrent('/projects') ? 'page' : undefined}>Projects</a>
			<a href={sitePath('/blog/')} aria-current={isCurrent('/blog') ? 'page' : undefined}>Blog</a>
		</nav>
		<div class="header-actions">
			<button
				class="search-trigger"
				type="button"
				data-search-open
				aria-label="Open site search"
				aria-haspopup="dialog"
			>
				<Icon name="search" />
				<span>Search</span>
				<kbd>⌘K / Ctrl K</kbd>
			</button>
			<a
				class="icon-button"
				href={GITHUB_URL}
				aria-label="GitHub profile"
				target="_blank"
				rel="noopener noreferrer"
			>
				<Icon name="github" />
			</a>
			<button
				class="icon-button theme-toggle"
				type="button"
				data-theme-toggle
				aria-label="Switch to light theme"
				aria-pressed="true"
			>
				<Icon name="sun" class="theme-icon theme-icon-light" />
				<Icon name="moon" class="theme-icon theme-icon-dark" />
			</button>
		</div>
	</div>
</header>

<script>
	const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
	const menuToggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
	const nav = document.querySelector<HTMLElement>('#primary-nav');

	if (themeToggle) {
		const updateTheme = (theme: 'light' | 'dark') => {
			document.documentElement.dataset.theme = theme;
			themeToggle.setAttribute('aria-pressed', String(theme === 'dark'));
			themeToggle.setAttribute(
				'aria-label',
				`Switch to ${theme === 'dark' ? 'light' : 'dark'} theme`,
			);
			themeToggle.setAttribute(
				'title',
				`Switch to ${theme === 'dark' ? 'light' : 'dark'} theme`,
			);
		};

		updateTheme(document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light');
		themeToggle.addEventListener('click', () => {
			const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
			localStorage.setItem('atlas-theme', nextTheme);
			updateTheme(nextTheme);
		});
	}

	if (menuToggle && nav) {
		const closeMenu = () => {
			menuToggle.setAttribute('aria-expanded', 'false');
			menuToggle.setAttribute('aria-label', 'Open navigation menu');
			nav.dataset.open = 'false';
		};

		menuToggle.addEventListener('click', () => {
			const isOpen = menuToggle.getAttribute('aria-expanded') === 'true';
			menuToggle.setAttribute('aria-expanded', String(!isOpen));
			menuToggle.setAttribute('aria-label', isOpen ? 'Open navigation menu' : 'Close navigation menu');
			nav.dataset.open = String(!isOpen);
		});

		nav.addEventListener('click', (event) => {
			if ((event.target as HTMLElement).closest('a')) closeMenu();
		});
	}
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		border-bottom: 1px solid var(--border);
		background: var(--background);
	}

	.nav-inner {
		display: flex;
		height: var(--nav-h);
		align-items: center;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.2rem;
		color: var(--text);
		font-size: 1rem;
		font-weight: 400;
		text-decoration: none;
	}

	.brand-mark {
		color: var(--accent);
		font-size: 2rem;
		font-family: Georgia, 'Times New Roman', serif;
		font-style: italic;
		font-weight: 400;
		letter-spacing: -0.08em;
		line-height: 1;
	}

	.primary-nav {
		position: absolute;
		left: 50%;
		display: flex;
		height: 100%;
		align-items: center;
		gap: 1.5rem;
		transform: translateX(-50%);
	}

	.primary-nav a {
		position: relative;
		display: inline-flex;
		height: 100%;
		align-items: center;
		color: var(--text);
		font-size: 0.9rem;
		text-decoration: none;
		transition: color 150ms ease;
	}

	.primary-nav a::after {
		position: absolute;
		right: 0;
		bottom: -1px;
		left: 0;
		height: 2px;
		background: transparent;
		content: '';
	}

	.primary-nav a:hover::after,
	.primary-nav a[aria-current='page']::after {
		background: var(--accent);
	}

	.primary-nav a[aria-current='page'] {
		color: var(--accent);
		font-weight: 700;
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-left: auto;
	}

	.icon-button {
		display: inline-grid;
		width: 2rem;
		height: 2rem;
		place-items: center;
		padding: 0;
		border: 1px solid var(--strong-border);
		border-radius: 6px;
		background: transparent;
		color: var(--text);
		text-decoration: none;
		cursor: pointer;
		transition:
			color 150ms ease,
			border-color 150ms ease;
	}

	.icon-button:hover,
	.search-trigger:hover {
		border-color: var(--text);
	}

	.search-trigger {
		display: inline-flex;
		min-height: 2rem;
		align-items: center;
		gap: 0.45rem;
		padding: 0.25rem 0.5rem;
		border: 1px solid var(--strong-border);
		border-radius: 6px;
		background: transparent;
		color: var(--text);
		font-size: 0.85rem;
		cursor: pointer;
		transition: border-color 150ms ease;
	}

	.search-trigger kbd {
		padding: 0.05rem 0.3rem;
		border: 1px solid var(--border);
		border-radius: 3px;
		color: var(--muted-text);
		font-family: var(--font-code);
		font-size: 0.7rem;
	}

	:global(.theme-icon-dark),
	:global(.menu-close-icon) {
		display: none;
	}

	:global(html[data-theme='light'] .theme-icon-light) {
		display: none;
	}

	:global(html[data-theme='light'] .theme-icon-dark),
	:global([aria-expanded='true'] .menu-close-icon) {
		display: block;
	}

	.mobile-menu-toggle {
		display: none;
	}

	@media (max-width: 767px) {
		.mobile-menu-toggle {
			display: grid;
			width: 2rem;
			height: 2rem;
			place-items: center;
			padding: 0;
			border: 1px solid var(--strong-border);
			border-radius: 6px;
			background: transparent;
			color: var(--text);
		}

		.primary-nav {
			position: absolute;
			top: var(--nav-h);
			right: 0;
			left: 0;
			display: none;
			height: auto;
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			margin-left: 0;
			padding: 0.35rem var(--gutter);
			border-bottom: 1px solid var(--border);
			background: var(--background);
			transform: none;
		}

		.primary-nav[data-open='true'] {
			display: flex;
		}

		.primary-nav a {
			height: 2.75rem;
		}

		.primary-nav a {
			border-bottom: 1px solid var(--border);
		}

		.primary-nav a:last-child {
			border-bottom: 0;
		}

		.primary-nav a::after {
			display: none;
		}

		.primary-nav a[aria-current='page'] {
			background: color-mix(in srgb, var(--accent) 10%, var(--background));
		}

		.header-actions {
			gap: 0.35rem;
		}

		.search-trigger span,
		.search-trigger kbd,
		.header-actions > .icon-button[href] {
			display: none;
		}
	}
</style>
