---
import Icon from './Icon.astro';
import { GITHUB_URL, SITE_TITLE } from '../consts';
---

<footer class="site-footer" data-pagefind-ignore>
	<div class="container footer-inner">
		<span>&copy; {new Date().getFullYear()} {SITE_TITLE}</span>
		<a href={GITHUB_URL} aria-label="GitHub" target="_blank" rel="noopener noreferrer">
			<Icon name="github" />
			<span class="visually-hidden">GitHub</span>
		</a>
	</div>
</footer>

<style>
	.site-footer {
		width: 100%;
		margin-top: auto;
		border-top: 1px solid var(--border);
	}

	.footer-inner {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding-block: 0.75rem 1rem;
		color: var(--muted-text);
		font-size: 0.8rem;
	}

	.footer-inner > span:first-child {
		margin-right: auto;
	}

	.footer-inner a {
		display: inline-grid;
		width: 2rem;
		height: 2rem;
		place-items: center;
		color: var(--text);
		text-decoration: none;
	}
</style>
