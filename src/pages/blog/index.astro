---
import { getCollection } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { readingTime, tagSlug } from '../../utils/blog';
import { sitePath } from '../../utils/paths';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---

<DocsLayout
	title="Blogs"
	description="Field notes on computer vision, datasets, model training, and software projects."
>
	<nav slot="right-sidebar" class="tag-navigation" aria-label="Browse posts by tag">
		<strong>Browse by topic</strong>
		{tags.map((tag) => (
			<a href={sitePath(`/blog/tags/${tagSlug(tag)}/`)}>{tag}</a>
		))}
	</nav>
	<section class="post-list" aria-label="Blog posts">
		{posts.map((post) => (
			<a class="post-row" href={sitePath(`/blog/${post.id}/`)}>
				<span class="post-row-copy">
					<span class="card-meta"><FormattedDate date={post.data.pubDate} /></span>
					<strong class="post-row-title">{post.data.title}</strong>
					<span class="post-row-description">{post.data.description}</span>
				</span>
				<span class="post-row-meta">
					<span>{readingTime(post.body)}</span>
				</span>
			</a>
		))}
	</section>
</DocsLayout>

<style>
	.tag-navigation {
		display: grid;
		justify-items: start;
		gap: 0.45rem;
		padding-left: 0.75rem;
	}

	.tag-navigation strong {
		margin-bottom: 0.1rem;
		font-size: 0.85rem;
	}

	.tag-navigation a {
		padding: 0.15rem 0.5rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		font-size: 0.8rem;
		text-decoration: none;
	}

	.tag-navigation a:hover {
		border-color: var(--text);
	}

</style>
