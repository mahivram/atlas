---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import DocsLayout from '../layouts/DocsLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import TargetDetectionSample from '../assets/target-detection-sample.png';
import { readingTime } from '../utils/blog';
import { sitePath } from '../utils/paths';

const projects = (await getCollection('projects')).sort(
	(a, b) => Number(b.data.featured) - Number(a.data.featured),
);
const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<DocsLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="hero">
		<div class="hero-copy">
			<h1>Ideas made practical.</h1>
			<p class="lead">
				A growing library of project work and clear notes about how each system is designed, built,
				and improved.
			</p>
		</div>
		<figure class="hero-figure">
			<Image
				src={TargetDetectionSample}
				alt="Circular targets on a grayscale grid used to collect examples for the target detector."
				width={1000}
			/>
		</figure>
	</section>

	<section aria-labelledby="projects-title">
		<div class="section-heading">
			<h2 id="projects-title">Projects</h2>
		</div>
		<div class="card-grid">
			{projects.map((project) => (
				<a class="card" href={sitePath(`/projects/${project.id.split('/')[0]}/`)}>
					<h3>{project.data.title}</h3>
					<p>{project.data.description}</p>
					<ul class="tag-list">
						{project.data.tags.map((tag) => <li>{tag}</li>)}
					</ul>
				</a>
			))}
		</div>
	</section>

	<section aria-labelledby="posts-title">
		<div class="section-heading">
			<h2 id="posts-title">Latest posts</h2>
		</div>
		<div class="post-list">
			{posts.map((post) => (
				<a class="post-row" href={sitePath(`/blog/${post.id}/`)}>
					<span class="post-row-copy">
						<span class="card-meta"><FormattedDate date={post.data.pubDate} /></span>
						<strong class="post-row-title">{post.data.title}</strong>
						<span class="post-row-description">{post.data.description}</span>
					</span>
					<span class="post-row-meta">
						<span>{readingTime(post.body)}</span>
					</span>
				</a>
			))}
		</div>
	</section>
</DocsLayout>

<style>
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(250px, 1.1fr);
		align-items: center;
		gap: 1.5rem;
		padding: 0.2rem 0 0.8rem;
	}

	.hero h1 {
		max-width: 800px;
		margin-bottom: 0.55rem;
	}

	.hero-figure {
		margin: 0;
	}

	.hero-figure img {
		display: block;
		width: 100%;
		border-radius: 4px;
	}

	.hero-figure figcaption {
		margin-top: 0.35rem;
		color: var(--muted-text);
		font-size: 0.75rem;
	}

	@media (max-width: 767px) {
		.hero {
			grid-template-columns: 1fr;
			gap: 0.9rem;
		}
	}
</style>
